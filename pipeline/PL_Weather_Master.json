{
	"name": "PL_Weather_Master",
	"properties": {
		"activities": [
			{
				"name": "FE_Each_Weather_Location",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Table_To_Load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Table_To_Load').output.resultSets[0].rows",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "EP_Run_Weather_Ingestion",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "SP_Start_Ingestion_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Weather_API_To_Bronze",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_location": {
										"value": "@item().location_name",
										"type": "Expression"
									},
									"p_latitude": {
										"value": "@item().latitude",
										"type": "Expression"
									},
									"p_longitude": {
										"value": "@item().longitude",
										"type": "Expression"
									},
									"p_start_date": {
										"value": "@pipeline().parameters.p_start_date",
										"type": "Expression"
									},
									"p_end_date": {
										"value": "@pipeline().parameters.p_end_date",
										"type": "Expression"
									},
									"p_api_mode": {
										"value": "@pipeline().parameters.p_api_mode",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "SP_Start_Ingestion_Attempt",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[control].[usp_StartIngestionAttempt]",
								"storedProcedureParameters": {
									"attempt_number": {
										"value": "1",
										"type": "Int32"
									},
									"bronze_path": {
										"value": "",
										"type": "String"
									},
									"location_name": {
										"value": {
											"value": "@item().location_name",
											"type": "Expression"
										},
										"type": "String"
									},
									"run_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"dataset_id": {
										"value": {
											"value": "@int(item().dataset_id)",
											"type": "Expression"
										},
										"type": "Int32"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_SQL_Lookup_config",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_Finish_Attempt_Succeeded",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "EP_Run_Weather_Ingestion",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[control].[usp_FinishIngestionAttempt]",
								"storedProcedureParameters": {
									"attempt_status": {
										"value": "SUCCEEDED",
										"type": "String"
									},
									"bronze_path": {
										"value": "",
										"type": "String"
									},
									"error_message": {
										"value": "",
										"type": "String"
									},
									"location_name": {
										"value": {
											"value": "@item().location_name",
											"type": "Expression"
										},
										"type": "String"
									},
									"records_written": {
										"value": "0",
										"type": "Int64"
									},
									"run_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"dataset_id": {
										"value": {
											"value": "@int(item().dataset_id)",
											"type": "Expression"
										},
										"type": "Int32"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_SQL_Lookup_config",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SP_Finish_Attempt_Failed",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [
								{
									"activity": "EP_Run_Weather_Ingestion",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[control].[usp_FinishIngestionAttempt]",
								"storedProcedureParameters": {
									"attempt_status": {
										"value": "FAILED",
										"type": "String"
									},
									"error_message": {
										"value": {
											"value": "@activity('EP_Run_Weather_Ingestion').error.message",
											"type": "Expression"
										},
										"type": "String"
									},
									"location_name": {
										"value": {
											"value": "@item().location_name",
											"type": "Expression"
										},
										"type": "String"
									},
									"records_written": {
										"value": "0",
										"type": "Int64"
									},
									"run_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									},
									"dataset_id": {
										"value": {
											"value": "@int(item().dataset_id)",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"bronze_path": {
										"value": "",
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_SQL_Lookup_config",
								"type": "LinkedServiceReference"
							}
						},
						{
							"name": "SV_Set_Failure_Location",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "EP_Run_Weather_Ingestion",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_temp_failed_locations",
								"value": {
									"value": "@union(\n    variables('v_failed_locations'),\n    createArray(item().location_name)\n)",
									"type": "Expression"
								}
							}
						},
						{
							"name": "SV_Update_Failed_Locations",
							"type": "SetVariable",
							"dependsOn": [
								{
									"activity": "SV_Set_Failure_Location",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "v_failed_locations",
								"value": {
									"value": "@variables('v_temp_failed_locations')",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Lookup_Table_To_Load",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "SP_Start_Pipeline_Run",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_SQL_Lookup_config",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "SELECT\n    l.location_name,\n    l.latitude,\n    l.longitude,\n    l. dataset_id\nFROM control.dataset_config AS d\nJOIN control.dataset_location AS l\n    ON d.dataset_id = l.dataset_id\nWHERE d.is_active = 1\n  AND l.is_active = 1\nORDER BY d.dataset_name, l.location_name;",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "SP_Start_Pipeline_Run",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control].[usp_StartPipelineRun]",
					"storedProcedureParameters": {
						"pipeline_name": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_SQL_Lookup_config",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_Finish_Pipeline_Run",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "IF_Check_Failed_Locations",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control].[usp_FinishPipelineRunFromAttempts]",
					"storedProcedureParameters": {
						"run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_SQL_Lookup_config",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "IF_Check_Failed_Locations",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "FE_Each_Weather_Location",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(length(variables('v_failed_locations')), 0)",
						"type": "Expression"
					},
					"ifTrueActivities": [
						{
							"name": "FAIL_Location_Processing",
							"type": "Fail",
							"dependsOn": [],
							"userProperties": [],
							"typeProperties": {
								"message": {
									"value": "@concat(\n    'Weather ingestion failed for locations: ',\n    join(variables('v_failed_locations'), ', ')\n)",
									"type": "Expression"
								},
								"errorCode": "LOCATION_PROCESSING_FAILED"
							}
						}
					]
				}
			}
		],
		"parameters": {
			"p_start_date": {
				"type": "string",
				"defaultValue": "@formatDateTime(utcNow(), 'yyyy-MM-dd')"
			},
			"p_end_date": {
				"type": "string",
				"defaultValue": "@formatDateTime(utcNow(), 'yyyy-MM-dd')"
			},
			"p_api_mode": {
				"type": "string"
			}
		},
		"variables": {
			"v_loaction": {
				"type": "String"
			},
			"v_failed_locations": {
				"type": "Array"
			},
			"v_temp_failed_locations": {
				"type": "Array"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-26T03:20:21Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}