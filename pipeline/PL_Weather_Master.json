{
	"name": "PL_Weather_Master",
	"properties": {
		"activities": [
			{
				"name": "FE_Each_Weather_Location",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Lookup_Table_To_Load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Lookup_Table_To_Load').output.resultSets[0].rows",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "EP_Run_Weather_Ingestion",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "SP_Start_Ingestion_Attempt",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "PL_Weather_API_To_Bronze",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"p_location": {
										"value": "@item().location_name",
										"type": "Expression"
									},
									"p_latitude": {
										"value": "@item().latitude",
										"type": "Expression"
									},
									"p_longitude": {
										"value": "@item().longitude",
										"type": "Expression"
									}
								}
							}
						},
						{
							"name": "SP_Start_Ingestion_Attempt",
							"type": "SqlServerStoredProcedure",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"storedProcedureName": "[control].[usp_StartIngestionAttempt]",
								"storedProcedureParameters": {
									"@attempt_number": {
										"value": "1",
										"type": "Int32"
									},
									"@bronze_path": {
										"value": "",
										"type": "String"
									},
									"@dataset_id": {
										"value": {
											"value": "@item().dataset_id",
											"type": "Expression"
										},
										"type": "Int32"
									},
									"@location_name": {
										"value": {
											"value": "@item().location_name",
											"type": "Expression"
										},
										"type": "String"
									},
									"@run_id": {
										"value": {
											"value": "@pipeline().RunId",
											"type": "Expression"
										},
										"type": "String"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_SQL_Lookup_config",
								"type": "LinkedServiceReference"
							}
						}
					]
				}
			},
			{
				"name": "Lookup_Table_To_Load",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "SP_Start_Pipeline_Run",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_SQL_Lookup_config",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "SELECT\n    l.location_name,\n    l.latitude,\n    l.longitude,\n    l. dataset_id\nFROM control.dataset_config AS d\nJOIN control.dataset_location AS l\n    ON d.dataset_id = l.dataset_id\nWHERE d.is_active = 1\n  AND l.is_active = 1\nORDER BY d.dataset_name, l.location_name;",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "SP_Start_Pipeline_Run",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[control].[usp_StartPipelineRun]",
					"storedProcedureParameters": {
						"@run_id": {
							"value": {
								"value": "@pipeline().RunId",
								"type": "Expression"
							}
						},
						"@pipeline_name": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							}
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_SQL_Lookup_config",
					"type": "LinkedServiceReference"
				}
			}
		],
		"annotations": [],
