{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "weather-energy-adf"
		},
		"LS_SQL_Lookup_config_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_Lookup_config'"
		},
		"LS_ADLS_Gen2_Weather_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://energystrgacc.dfs.core.windows.net/"
		},
		"LS_OpenMeteo_HTTP_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().p_base_url}"
		},
		"LS_SQL_Lookup_config_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "weather-energy.database.windows.net"
		},
		"LS_SQL_Lookup_config_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "weather_energy"
		},
		"LS_SQL_Lookup_config_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "weather-energy"
		},
		"LS_Secret_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://WeatherSecret.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "weather-energy-adf_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_SQL_Lookup_config_password": {
						"value": "[parameters('LS_SQL_Lookup_config_password')]"
					},
					"LS_ADLS_Gen2_Weather_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Gen2_Weather_properties_typeProperties_url')]"
					},
					"LS_OpenMeteo_HTTP_properties_typeProperties_url": {
						"value": "[parameters('LS_OpenMeteo_HTTP_properties_typeProperties_url')]"
					},
					"LS_SQL_Lookup_config_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_Lookup_config_properties_typeProperties_server')]"
					},
					"LS_SQL_Lookup_config_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_Lookup_config_properties_typeProperties_database')]"
					},
					"LS_SQL_Lookup_config_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_Lookup_config_properties_typeProperties_userName')]"
					},
					"LS_Secret_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_Secret_properties_typeProperties_baseUrl')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}