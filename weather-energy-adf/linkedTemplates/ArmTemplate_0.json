{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "weather-energy-adf"
		},
		"LS_SQL_Lookup_config_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_Lookup_config'"
		},
		"LS_ADLS_Gen2_Weather_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://energystrgacc.dfs.core.windows.net/"
		},
		"LS_OpenMeteo_HTTP_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().p_base_url}"
		},
		"LS_SQL_Lookup_config_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "weather-energy.database.windows.net"
		},
		"LS_SQL_Lookup_config_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "weather_energy"
		},
		"LS_SQL_Lookup_config_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "weather-energy"
		},
		"LS_Secret_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://WeatherSecret.vault.azure.net/"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/LS_ADLS_Gen2_Weather')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobFS",
				"typeProperties": {
					"url": "[parameters('LS_ADLS_Gen2_Weather_properties_typeProperties_url')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_OpenMeteo_HTTP')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"parameters": {
					"p_base_url": {
						"type": "string",
						"defaultValue": "https://api.open-meteo.com/"
					}
				},
				"annotations": [],
				"type": "HttpServer",
				"typeProperties": {
					"url": "[parameters('LS_OpenMeteo_HTTP_properties_typeProperties_url')]",
					"enableServerCertificateValidation": true,
					"authenticationType": "Anonymous"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_SQL_Lookup_config')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_SQL_Lookup_config_properties_typeProperties_server')]",
					"database": "[parameters('LS_SQL_Lookup_config_properties_typeProperties_database')]",
					"encrypt": "strict",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_SQL_Lookup_config_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_SQL_Lookup_config_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_Secret')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureKeyVault",
				"typeProperties": {
					"baseUrl": "[parameters('LS_Secret_properties_typeProperties_baseUrl')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Bronze_Chennai_Forecast')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_Gen2_Weather",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"p_location": {
						"type": "string",
						"defaultValue": "chennai"
					},
					"p_fileName": {
						"type": "string",
						"defaultValue": "forecast.json"
					},
					"p_apiMode": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@dataset().p_fileName",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@concat('weather/',toLower(dataset().p_apiMode),'/location=', dataset().p_location)",
							"type": "Expression"
						},
						"fileSystem": "bronze"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_Gen2_Weather')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_OpenMeteo_HTTP_Forecast')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_OpenMeteo_HTTP",
					"type": "LinkedServiceReference",
					"parameters": {
						"p_base_url": {
							"value": "@if(equals(dataset().p_api_mode, 'archive'), 'https://archive-api.open-meteo.com/', 'https://api.open-meteo.com/')",
							"type": "Expression"
						}
					}
				},
				"parameters": {
					"p_latitude": {
						"type": "string",
						"defaultValue": "13.0827"
					},
					"p_longitude": {
						"type": "string",
						"defaultValue": "80.2707"
					},
					"p_start_date": {
						"type": "string"
					},
					"p_end_date": {
						"type": "string"
					},
					"p_api_mode": {
						"type": "string",
						"defaultValue": "forecast"
					}
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "HttpServerLocation",
						"relativeUrl": {
							"value": "@if(equals(dataset().p_api_mode, 'forecast'), concat('v1/forecast?latitude=', dataset().p_latitude, '&longitude=', dataset().p_longitude, '&hourly=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m&forecast_days=7&timezone=UTC'), concat('v1/archive?latitude=', dataset().p_latitude, '&longitude=', dataset().p_longitude, '&hourly=temperature_2m,relative_humidity_2m,precipitation,wind_speed_10m&start_date=', dataset().p_start_date, '&end_date=', dataset().p_end_date, '&timezone=UTC'))",
							"type": "Expression"
						}
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_OpenMeteo_HTTP')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_Weather_Bronze_JSON')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_Gen2_Weather",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "Json",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"folderPath": "weather",
						"fileSystem": "bronze"
					}
				},
				"schema": {}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_Gen2_Weather')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Lookup_config_table')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_SQL_Lookup_config",
					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [],
				"typeProperties": {
					"schema": "control",
					"table": "dataset_location"
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_SQL_Lookup_config')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Weather_API_To_Bronze')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "CP_Chennai_Forecast_To_Bronze",
						"type": "Copy",
						"dependsOn": [],
						"policy": {
							"timeout": "0.10:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "JsonSource",
								"storeSettings": {
									"type": "HttpReadSettings",
									"requestMethod": "GET"
								},
								"formatSettings": {
									"type": "JsonReadSettings"
								}
							},
							"sink": {
								"type": "JsonSink",
								"storeSettings": {
									"type": "AzureBlobFSWriteSettings"
								},
								"formatSettings": {
									"type": "JsonWriteSettings"
								}
							},
							"enableStaging": false
						},
						"inputs": [
							{
								"referenceName": "DS_OpenMeteo_HTTP_Forecast",
								"type": "DatasetReference",
								"parameters": {
									"p_latitude": {
										"value": "@pipeline().parameters.p_latitude",
										"type": "Expression"
									},
									"p_longitude": {
										"value": "@pipeline().parameters.p_longitude",
										"type": "Expression"
									},
									"p_start_date": {
										"value": "@pipeline().parameters.p_start_date",
										"type": "Expression"
									},
									"p_end_date": {
										"value": "@pipeline().parameters.p_end_date",
										"type": "Expression"
									},
									"p_api_mode": {
										"value": "@pipeline().parameters.p_api_mode",
										"type": "Expression"
									}
								}
							}
						],
						"outputs": [
							{
								"referenceName": "DS_Bronze_Chennai_Forecast",
								"type": "DatasetReference",
								"parameters": {
									"p_location": {
										"value": "@pipeline().parameters.p_location",
										"type": "Expression"
									},
									"p_fileName": {
										"value": "@if(\n    equals(toLower(pipeline().parameters.p_api_mode), 'forecast'),\n    concat(\n        'forecast_',\n        formatDateTime(utcNow(), 'yyyy-MM-dd'),\n        '_to_',\n        formatDateTime(addDays(utcNow(), 7), 'yyyy-MM-dd'),\n        '_',\n        pipeline().RunId,\n        '.json'\n    ),\n    concat(\n        'archive_',\n        pipeline().parameters.p_start_date,\n        '_to_',\n        pipeline().parameters.p_end_date,\n        '_',\n        pipeline().RunId,\n        '.json'\n    )\n)",
										"type": "Expression"
									},
									"p_apiMode": {
										"value": "@pipeline().parameters.p_api_mode",
										"type": "Expression"
									}
								}
							}
						]
					},
					{
						"name": "FAIL_Weather_Ingestion",
						"description": "",
						"type": "Fail",
						"dependsOn": [
							{
								"activity": "CP_Chennai_Forecast_To_Bronze",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"message": "Weather API ingestion failed. Check the Copy activity output",
							"errorCode": "WEATHER_INGESTION_FAILED"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"p_location": {
						"type": "string",
						"defaultValue": "chennai"
					},
					"p_latitude": {
						"type": "string",
						"defaultValue": "13.0827"
					},
					"p_longitude": {
						"type": "string",
						"defaultValue": "80.2707"
					},
					"p_start_date": {
						"type": "string"
					},
					"p_end_date": {
						"type": "string"
					},
					"p_api_mode": {
						"type": "string",
						"defaultValue": "forecast"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-26T03:03:09Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_OpenMeteo_HTTP_Forecast')]",
				"[concat(variables('factoryId'), '/datasets/DS_Bronze_Chennai_Forecast')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/PL_Weather_Master')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Lookup_Table_To_Load",
						"type": "Script",
						"dependsOn": [
							{
								"activity": "SP_Start_Pipeline_Run",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 2,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "LS_SQL_Lookup_config",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "Query",
									"text": {
										"value": "DECLARE @recovery_run_id VARCHAR(100) =\n    NULLIF('@{pipeline().parameters.p_recovery_run_id}', '');\n\nDECLARE @current_api_mode VARCHAR(20) =\n    '@{pipeline().parameters.p_api_mode}';\n\nDECLARE @current_start_date DATE =\n    TRY_CONVERT(DATE, NULLIF('@{pipeline().parameters.p_start_date}', ''));\n\nDECLARE @current_end_date DATE =\n    TRY_CONVERT(DATE, NULLIF('@{pipeline().parameters.p_end_date}', ''));\n\n-- Automatic recovery: latest eligible failed/partial run\nIF @recovery_run_id IS NULL\nBEGIN\n    SELECT TOP 1\n        @recovery_run_id =\n            CASE\n                WHEN run_status IN ('PARTIAL', 'FAILED')\n                 AND api_mode IS NOT NULL\n                 AND LOWER(api_mode) = LOWER(@current_api_mode)\n                 AND (\n                     LOWER(api_mode) = 'forecast'\n                     OR (\n                         LOWER(api_mode) = 'archive'\n                         AND start_date IS NOT NULL\n                         AND end_date IS NOT NULL\n                     )\n                 )\n                THEN run_id\n                ELSE NULL\n            END\n    FROM control.pipeline_run_history\n    ORDER BY started_at DESC, run_id DESC;\nEND;\n\n;WITH RecoveryRows AS\n(\n    SELECT\n        CAST(1 AS INT) AS execution_phase,\n        p.run_id AS recovery_run_id,\n        CAST(a.attempt_id AS BIGINT) AS retry_of_attempt_id,\n        CAST(a.attempt_number + 1 AS INT) AS attempt_number,\n        p.api_mode,\n        p.start_date,\n        p.end_date,\n        d.dataset_id,\n        d.dataset_name,\n        l.location_name,\n        l.latitude,\n        l.longitude\n    FROM control.pipeline_run_history p\n    JOIN control.ingestion_attempt_history a\n        ON a.run_id = p.run_id\n    JOIN control.dataset_config d\n        ON d.dataset_id = a.dataset_id\n    JOIN control.dataset_location l\n        ON l.dataset_id = a.dataset_id\n       AND l.location_name = a.location_name\n    WHERE p.run_id = @recovery_run_id\n      AND p.run_status IN ('PARTIAL', 'FAILED')\n      AND d.is_active = 1\n      AND l.is_active = 1\n      AND a.attempt_id = (\n          SELECT MAX(a2.attempt_id)\n          FROM control.ingestion_attempt_history a2\n          WHERE a2.run_id = a.run_id\n            AND a2.dataset_id = a.dataset_id\n            AND a2.location_name = a.location_name\n      )\n      AND a.attempt_status = 'FAILED'\n),\nRegularRows AS\n(\n    SELECT\n        CAST(2 AS INT) AS execution_phase,\n        CAST(NULL AS VARCHAR(100)) AS recovery_run_id,\n        CAST(NULL AS BIGINT) AS retry_of_attempt_id,\n        CAST(1 AS INT) AS attempt_number,\n        @current_api_mode AS api_mode,\n        @current_start_date AS start_date,\n        @current_end_date AS end_date,\n        d.dataset_id,\n        d.dataset_name,\n        l.location_name,\n        l.latitude,\n        l.longitude\n    FROM control.dataset_config d\n    JOIN control.dataset_location l\n        ON d.dataset_id = l.dataset_id\n    WHERE d.is_active = 1\n      AND l.is_active = 1\n),\nCombinedRows AS\n(\n    SELECT * FROM RecoveryRows\n    UNION ALL\n    SELECT * FROM RegularRows\n)\nSELECT\n    execution_phase,\n    recovery_run_id,\n    retry_of_attempt_id,\n    attempt_number,\n    api_mode,\n    start_date,\n    end_date,\n    dataset_id,\n    dataset_name,\n    location_name,\n    latitude,\n    longitude\nFROM CombinedRows\nORDER BY\n    execution_phase,\n    dataset_name,\n    location_name;",
										"type": "Expression"
									}
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "SP_Start_Pipeline_Run",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[control].[usp_StartPipelineRun]",
							"storedProcedureParameters": {
								"api_mode": {
									"value": {
										"value": "@pipeline().parameters.p_api_mode",
										"type": "Expression"
									},
									"type": "String"
								},
								"end_date": {
									"value": {
										"value": "@pipeline().parameters.p_end_date",
										"type": "Expression"
									},
									"type": "DateTime"
								},
								"pipeline_name": {
									"value": {
										"value": "@pipeline().Pipeline",
										"type": "Expression"
									},
									"type": "String"
								},
								"run_id": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "String"
								},
								"start_date": {
									"value": {
										"value": "@pipeline().parameters.p_start_date",
										"type": "Expression"
									},
									"type": "DateTime"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_SQL_Lookup_config",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "SP_Finish_Pipeline_Run",
						"type": "SqlServerStoredProcedure",
						"dependsOn": [
							{
								"activity": "IF_Check_Failed_Locations",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"storedProcedureName": "[[control].[usp_FinishPipelineRunFromAttempts]",
							"storedProcedureParameters": {
								"run_id": {
									"value": {
										"value": "@pipeline().RunId",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
						"linkedServiceName": {
							"referenceName": "LS_SQL_Lookup_config",
							"type": "LinkedServiceReference"
						}
					},
					{
						"name": "IF_Check_Failed_Locations",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "FE_All_Ingestion",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(length(variables('v_failed_locations')), 0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "FAIL_Location_Processing",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"message": {
											"value": "@concat(\n    'Weather ingestion failed for locations: ',\n    join(variables('v_failed_locations'), ', ')\n)",
											"type": "Expression"
										},
										"errorCode": "LOCATION_PROCESSING_FAILED"
									}
								}
							]
						}
					},
					{
						"name": "LK_Get_Final_Run_Status",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "SP_Finish_Pipeline_Run",
								"dependencyConditions": [
									"Completed"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "@concat(\n    'SELECT run_status FROM control.pipeline_run_history WHERE run_id = ''',\n    pipeline().RunId,\n    ''''\n)",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "Lookup_config_table",
								"type": "DatasetReference",
								"parameters": {}
							}
						}
					},
					{
						"name": "IF_Final_Status_Check",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "LK_Get_Final_Run_Status",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@not(equals(\n    activity('LK_Get_Final_Run_Status').output.firstRow.run_status,\n    'SUCCEEDED'\n))",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "FAIL_Final_Pipeline_Status",
									"type": "Fail",
									"dependsOn": [],
									"userProperties": [],
