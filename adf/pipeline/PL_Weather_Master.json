			{
				"name": "Lookup_Table_To_Load",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "SP_Start_Pipeline_Run",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 2,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_SQL_Lookup_config",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "DECLARE @current_api_mode VARCHAR(20) =\n    '@{pipeline().parameters.p_api_mode}';\n\nDECLARE @current_start_date DATE =\n    TRY_CONVERT(DATE, NULLIF(\n        '@{pipeline().parameters.p_start_date}', ''\n    ));\n\nDECLARE @current_end_date DATE =\n    TRY_CONVERT(DATE, NULLIF(\n        '@{pipeline().parameters.p_end_date}', ''\n    ));\n\nDECLARE @manual_recovery_run_id VARCHAR(100) =\n    NULLIF('@{pipeline().parameters.p_recovery_run_id}', '');\n\nDECLARE @recovery_run_id VARCHAR(100);\n\n-- Select previous failed/partial run for the same API mode\nIF @manual_recovery_run_id IS NOT NULL\nBEGIN\n    SET @recovery_run_id = @manual_recovery_run_id;\nEND\nELSE\nBEGIN\n    SELECT TOP 1\n        @recovery_run_id = run_id\n    FROM control.pipeline_run_history\n    WHERE run_status IN ('PARTIAL', 'FAILED')\n      AND api_mode IS NOT NULL\n      AND LOWER(api_mode) = LOWER(@current_api_mode)\n      AND (\n          LOWER(api_mode) = 'forecast'\n          OR (\n              LOWER(api_mode) = 'archive'\n              AND start_date IS NOT NULL\n              AND end_date IS NOT NULL\n          )\n      )\n    ORDER BY started_at DESC;\nEND;\n\n-- RESULT SET 1: Current request\nSELECT\n    @current_api_mode AS api_mode,\n    @current_start_date AS start_date,\n    @current_end_date AS end_date;\n\n-- RESULT SET 2: All active locations for regular ingestion\nSELECT\n    d.dataset_id,\n    d.dataset_name,\n    l.location_name,\n    l.latitude,\n    l.longitude\nFROM control.dataset_config d\nJOIN control.dataset_location l\n    ON d.dataset_id = l.dataset_id\nWHERE d.is_active = 1\n  AND l.is_active = 1\nORDER BY d.dataset_name, l.location_name;\n\n-- RESULT SET 3: Previous failed request and failed locations\nSELECT\n    p.run_id AS recovery_run_id,\n    p.api_mode,\n    p.start_date,\n    p.end_date,\n    l.dataset_id,\n    d.dataset_name,\n    l.location_name,\n    l.latitude,\n    l.longitude\nFROM control.pipeline_run_history p\nJOIN control.ingestion_attempt_history a\n    ON a.run_id = p.run_id\nJOIN control.dataset_config d\n    ON d.dataset_id = a.dataset_id\nJOIN control.dataset_location l\n    ON l.dataset_id = a.dataset_id\n   AND l.location_name = a.location_name\nWHERE p.run_id = @recovery_run_id\n  AND d.is_active = 1\n  AND l.is_active = 1\n  AND a.attempt_status = 'FAILED'\n  AND a.attempt_id = (\n      SELECT MAX(a2.attempt_id)\n      FROM control.ingestion_attempt_history a2\n      WHERE a2.run_id = a.run_id\n        AND a2.dataset_id = a.dataset_id\n        AND a2.location_name = a.location_name\n  )\nORDER BY d.dataset_name, l.location_name;",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
